{
  "name": "jirafedrunek",
  "version": "0.1.0",
  "description": "Sync Jira issues + comments and Confluence pages/spaces to local Markdown files, idempotently, via Atlassian's hosted MCP server",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "jiraFedrunek": "src/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/node/*.test.js",
    "login": "node src/index.js login"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "gray-matter": "4.0.3",
    "p-limit": "7.3.2",
    "p-retry": "8.0.1",
    "smol-toml": "1.8.0"
  },
  "license": "MIT"
}

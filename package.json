{
  "name": "jirafedrunek",
  "version": "0.1.0",
  "description": "Sync Jira issues + comments and Confluence pages/spaces to local Markdown files, idempotently, via Atlassian's hosted MCP server",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "jiraFedrunek": "src/index.js"
  },
  "files": [
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/node/*.test.js",
    "login": "node src/index.js login",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests}/**/*.js\" \"*.js\"",
    "format:check": "prettier --check \"{src,tests}/**/*.js\" \"*.js\""
  },
  "dependencies": {
    "@11ty/gray-matter": "3.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "15.1.0",
    "mcp-remote": "0.16.6",
    "p-limit": "7.3.3",
    "p-retry": "9.0.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk@1.32.2": {
      "@hono/node-server": "2.1.7",
      "body-parser": "2.4.0",
      "fast-uri": "3.1.9",
      "qs": "6.17.1",
      "zod": "4.6.7"
    },
    "mcp-remote@0.16.6": {
      "body-parser": "1.20.9",
      "qs": "6.17.1",
      "undici": "7.30.2"
    },
    "eslint@10.14.0": {
      "minimatch": "11.0.8"
    }
  },
  "license": "MIT"
}

{
  "name": "jirafedrunek",
  "version": "0.1.0",
  "description": "Sync Jira issues + comments and Confluence pages/spaces to local Markdown files, idempotently, via Atlassian's hosted MCP server",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "jiraFedrunek": "src/index.js"
  },
  "files": [
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/node/*.test.js",
    "login": "node src/index.js login",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests}/**/*.js\" \"*.js\"",
    "format:check": "prettier --check \"{src,tests}/**/*.js\" \"*.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "14.0.3",
    "gray-matter": "4.0.3",
    "mcp-remote": "0.8.3",
    "p-limit": "7.3.2",
    "p-retry": "8.0.1",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.5.0",
    "prettier": "3.8.3"
  },
  "overrides": {
    "mcp-remote@0.8.3": {
      "body-parser": "1.20.6",
      "qs": "6.16.0"
    }
  },
  "license": "MIT"
}
